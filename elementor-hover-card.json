{
  "version": "0.4",
  "title": "Futuristische Hover Card",
  "type": "section",
  "content": [
    {
      "id": "section-hover-card",
      "elType": "section",
      "settings": {
        "structure": "100",
        "layout": "full_width",
        "content_width": "full",
        "gap": "extended"
      },
      "elements": [
        {
          "id": "column-hover-card",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "widget-hover-card-html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "editor": "<div class=\"hover-card-template\">\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap');\n\n    .hover-card-template {\n      color-scheme: dark;\n      font-family: \"Space Grotesk\", system-ui, -apple-system, BlinkMacSystemFont,\n        \"Segoe UI\", sans-serif;\n      --bg: #030712;\n      --card: rgba(10, 14, 25, 0.95);\n      --accent: #66ffe7;\n      --accent-2: #8c4bff;\n      --text: #f5f8ff;\n      --muted: #9fb0c7;\n      background: radial-gradient(circle at top, #121b35 0%, var(--bg) 55%);\n      padding: clamp(3rem, 8vw, 6rem) 1.5rem;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 70vh;\n      color: var(--text);\n    }\n\n    .hover-card-template .scene {\n      width: min(500px, 100%);\n      perspective: 1400px;\n    }\n\n    .hover-card-template .hover-card {\n      position: relative;\n      background: var(--card);\n      border-radius: 32px;\n      padding: clamp(2rem, 6vw, 2.8rem);\n      backdrop-filter: blur(18px);\n      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);\n      overflow: hidden;\n      transform-style: preserve-3d;\n      transition: transform 0.3s ease, box-shadow 0.3s ease;\n    }\n\n    .hover-card-template .hover-card::before,\n    .hover-card-template .hover-card::after {\n      content: \"\";\n      position: absolute;\n      inset: -40% -10%;\n      background: conic-gradient(\n        from 90deg,\n        rgba(102, 255, 231, 0.4),\n        rgba(140, 75, 255, 0.25),\n        transparent 60%\n      );\n      filter: blur(50px);\n      opacity: 0;\n      transition: opacity 0.4s ease;\n      z-index: 0;\n    }\n\n    .hover-card-template .hover-card::after {\n      inset: -30% -30%;\n      background: radial-gradient(circle, rgba(102, 255, 231, 0.2), transparent);\n      filter: blur(80px);\n    }\n\n    .hover-card-template .hover-card:hover::before,\n    .hover-card-template .hover-card:hover::after,\n    .hover-card-template .hover-card.is-hovered::before,\n    .hover-card-template .hover-card.is-hovered::after {\n      opacity: 1;\n    }\n\n    .hover-card-template .hover-card .glow {\n      position: absolute;\n      inset: 2px;\n      border-radius: inherit;\n      border: 1px solid rgba(255, 255, 255, 0.08);\n      background: linear-gradient(\n        120deg,\n        rgba(255, 255, 255, 0.04),\n        rgba(102, 255, 231, 0.05),\n        rgba(140, 75, 255, 0.02)\n      );\n      z-index: 1;\n      pointer-events: none;\n    }\n\n    .hover-card-template .card-content {\n      position: relative;\n      z-index: 2;\n      display: flex;\n      flex-direction: column;\n      gap: 1rem;\n    }\n\n    .hover-card-template .eyebrow {\n      text-transform: uppercase;\n      letter-spacing: 0.3em;\n      font-size: 0.75rem;\n      color: var(--accent);\n    }\n\n    .hover-card-template h1 {\n      font-size: clamp(2rem, 4vw, 2.8rem);\n      line-height: 1.1;\n    }\n\n    .hover-card-template .description {\n      color: var(--muted);\n      line-height: 1.6;\n    }\n\n    .hover-card-template .card-meta {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n      gap: 0.75rem;\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n\n    .hover-card-template .card-meta li {\n      padding: 0.75rem 1rem;\n      border-radius: 16px;\n      background: rgba(255, 255, 255, 0.04);\n      border: 1px solid rgba(255, 255, 255, 0.06);\n    }\n\n    .hover-card-template .card-meta .label {\n      font-size: 0.75rem;\n      text-transform: uppercase;\n      color: var(--muted);\n      letter-spacing: 0.15em;\n    }\n\n    .hover-card-template .card-meta strong {\n      display: block;\n      margin-top: 0.3rem;\n      font-size: 1.1rem;\n    }\n\n    .hover-card-template .primary {\n      margin-top: 0.5rem;\n      padding: 0.95rem 1.5rem;\n      border-radius: 999px;\n      border: none;\n      background: linear-gradient(120deg, var(--accent), var(--accent-2));\n      color: var(--bg);\n      font-weight: 600;\n      font-size: 1rem;\n      letter-spacing: 0.05em;\n      cursor: pointer;\n      transition: transform 0.3s ease, box-shadow 0.3s ease;\n      box-shadow: 0 10px 35px rgba(102, 255, 231, 0.35);\n    }\n\n    .hover-card-template .primary:hover {\n      transform: translateY(-2px) scale(1.02);\n      box-shadow: 0 20px 45px rgba(102, 255, 231, 0.45);\n    }\n\n    .hover-card-template .hover-card.is-hovered {\n      box-shadow: 0 25px 80px rgba(12, 17, 40, 0.75);\n    }\n  </style>\n  <div class=\"scene\" role=\"presentation\">\n    <article class=\"hover-card\" aria-label=\"Produkt Highlight\">\n      <div class=\"glow\"></div>\n      <div class=\"card-content\">\n        <p class=\"eyebrow\">Neu</p>\n        <h1>Neon Access Pass</h1>\n        <p class=\"description\">\n          Entdecke die Zukunft der Events: personalisierte Zugänge, holografische\n          Visuals und KI-gestützte Empfehlungen in einer Card.\n        </p>\n        <ul class=\"card-meta\" aria-label=\"Highlights\">\n          <li>\n            <span class=\"label\">Verfügbarkeit</span>\n            <strong>Ab sofort</strong>\n          </li>\n          <li>\n            <span class=\"label\">Preis</span>\n            <strong>129 €</strong>\n          </li>\n        </ul>\n        <button class=\"primary\">Jetzt sichern</button>\n      </div>\n    </article>\n  </div>\n</div>\n<script>\n(() => {\n  const container = document.currentScript.previousElementSibling;\n  if (!container) return;\n  const card = container.querySelector('.hover-card');\n  if (!card) return;\n\n  const handleMove = (event) => {\n    const bounds = card.getBoundingClientRect();\n    const centerX = bounds.left + bounds.width / 2;\n    const centerY = bounds.top + bounds.height / 2;\n    const x = event.clientX - centerX;\n    const y = event.clientY - centerY;\n    const rotateX = (y / bounds.height) * -10;\n    const rotateY = (x / bounds.width) * 10;\n    card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n  };\n\n  const resetCard = () => {\n    card.style.transform = 'rotateX(0deg) rotateY(0deg)';\n  };\n\n  card.addEventListener('pointermove', (event) => {\n    card.classList.add('is-hovered');\n    handleMove(event);\n  });\n\n  card.addEventListener('pointerenter', () => {\n    card.classList.add('is-hovered');\n  });\n\n  card.addEventListener('pointerleave', () => {\n    card.classList.remove('is-hovered');\n    resetCard();\n  });\n\n  card.addEventListener('pointerdown', () => card.classList.add('is-hovered'));\n  card.addEventListener('pointerup', () => card.classList.add('is-hovered'));\n})();\n</script>"
              },
              "elements": [],
              "isInner": false
            }
          ],
          "isInner": false
        }
      ],
      "isInner": false
    }
  ]
}